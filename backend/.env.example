PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/apartment_management
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# console = in OTP ra console + trả trong response (dev/demo); smtp = gửi email thật
MAIL_MODE=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# Gmail: dùng App Password (Google Account > Security > App passwords)
SMTP_PASS=
MAIL_FROM=

# Thư mục lưu ảnh upload (mặc định backend/uploads)
# UPLOAD_DIR=

# Module vận hành cần replica set (transaction). Dev không cần cài Mongo: npm run db rồi dùng:
# MONGODB_URI=mongodb://127.0.0.1:27018/apartment_management?replicaSet=rs0
